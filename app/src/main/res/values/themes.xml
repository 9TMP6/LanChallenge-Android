<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Project1" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="style_header">
        <item name="android:fontFamily">@font/nunito_black</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@animator/btn_nhung</item>
        <item name="android:clickable">true</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="style_h2">
        <item name="android:stateListAnimator">@animator/btn_nhung</item>
        <item name="android:clickable">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:fontFamily">@font/nunito_black</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="style_btnAns">
        <item name="android:hapticFeedbackEnabled">true</item>
        <item name="android:fontFamily">@font/nunito_black</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_height">100dp</item>
        <item name="android:maxLines">3</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginHorizontal">12dp</item>
        <item name="android:maxWidth">80dp</item>
        <item name="android:paddingHorizontal">7dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@animator/btngames</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#EEEEEE</item>
        <item name="android:background">@drawable/btn_game</item>
    </style>

    <style name="Theme.Project1" parent="Base.Theme.Project1" />
</resources>