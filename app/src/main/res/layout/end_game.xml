<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#222222">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">
        <ImageView
            android:id="@+id/imgTrophy"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_cheer"
            app:tint="#4ec95d"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quá Xuất Sắc!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/nunito_black"
            android:textColor="#54B158"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvSubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tôi tin bạn sẽ làm được mà!"
            android:textSize="14sp"
            android:fontFamily="@font/nunito_black"
            android:textColor="#888888"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:background="@drawable/bg_btndetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/txtScoreEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10/10"
                    android:textSize="20sp"
                    android:fontFamily="@font/nunito_black"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Điểm số"
                    android:fontFamily="@font/nunito_black"
                    android:textSize="12sp"
                    android:textColor="#757575" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/txtPercentEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textSize="20sp"
                    android:fontFamily="@font/nunito_black"
                    android:textStyle="bold"
                    android:textColor="#388E3C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chính xác"
                    android:textSize="12sp"
                    android:fontFamily="@font/nunito_black"
                    android:textColor="#757575" />
            </LinearLayout>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHomeEnd"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Về Màn Hình Chính"
            android:fontFamily="@font/nunito_black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:stateListAnimator="@animator/btn_nhung"
            android:background="@drawable/btn_kiemtra_true"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>