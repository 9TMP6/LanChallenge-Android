<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#222222"
    android:orientation="vertical"
    android:paddingTop="30dp"
    tools:context=".frag_adddocument">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:backgroundTint="@color/white"
            android:paddingStart="15dp"
            android:stateListAnimator="@animator/btn_truot"
            app:icon="@drawable/ic_close_2"
            app:iconSize="35sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtHeader_AddDoc"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="center_vertical"
            android:autoSizeMaxTextSize="30sp"
            android:autoSizeTextType="uniform"
            android:clickable="true"
            android:fontFamily="@font/nunito_black"
            android:gravity="center_vertical"
            android:letterSpacing="0.05"
            android:stateListAnimator="@animator/btn_nhung"
            android:text="Thêm tài liệu"
            android:textColor="@color/white"
            android:textSize="28sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_close"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_new_addDoc"
            android:layout_width="90dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="25dp"
            android:background="@drawable/bg_adddoc_typedoc"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/nunito_black"
            android:gravity="center"
            android:stateListAnimator="@animator/btn_nhung"
            android:text="New"
            android:textColor="#5a8fe1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txt_other_addDoc"
            android:layout_width="90dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_adddoc_typedoc"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/nunito_black"
            android:gravity="center"
            android:stateListAnimator="@animator/btn_nhung"
            android:text="Other"
            android:textColor="#5a8fe1"
            android:textSize="15sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_btndetail"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:id="@+id/txt_luuy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:fontFamily="@font/nunito_black"
            android:justificationMode="inter_word"
            android:stateListAnimator="@animator/btn_nhung"
            android:text="Tạo một từ điển rỗng để bạn chủ động thêm từ mới trong quá trình ôn tập. Cài đặt có thể thay đổi bất kỳ lúc nào. Vui lòng kết nối mạng để có trải nghiệm tốt nhất."
            android:textColor="@color/white"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/img_luuy"
            android:visibility="gone"
            android:layout_width="300dp"
            android:layout_height="70dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:scaleType="fitXY"
            android:src="@drawable/img_luuy" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lNew"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_btndetail"
        android:orientation="vertical"
        android:paddingHorizontal="15dp"
        android:paddingVertical="20dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:fontFamily="@font/nunito_black"
            android:text="Tên tài liệu"
            android:textColor="#BBBBBB"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edt_tenDoc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_black"
            android:hint="đặt tên tài liệu"
            android:maxLength="20"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textColorHint="#999999"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/nunito_black"
            android:text="Tên file"
            android:textColor="#BBBBBB"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edt_tenFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#999999"
            android:enabled="false"
            android:fontFamily="@font/nunito_black"
            android:maxLines="1"
            android:text=".txt"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_themDoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btndetail"
            android:fontFamily="@font/nunito_black"
            android:paddingHorizontal="15dp"
            android:stateListAnimator="@animator/btn_nhung"
            android:text="Xác nhận thêm"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/lOther"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_btndetail"
        android:orientation="vertical"
        android:paddingHorizontal="15dp"
        android:paddingVertical="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:fontFamily="@font/nunito_black"
            android:text="Tên tài liệu"
            android:textColor="#BBBBBB"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edt_tenDocFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_black"
            android:hint="đặt tên tài liệu"
            android:maxLength="20"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textColorHint="#999999"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/nunito_black"
            android:text="Chọn file txt"
            android:textColor="#BBBBBB"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txt_linkFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:background="@drawable/bg_adddoc_typedoc"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/nunito_black"
            android:gravity="center"
            android:hint="Chọn file của bạn"
            android:maxLines="1"
            android:paddingVertical="3dp"
            android:stateListAnimator="@animator/btn_nhung"
            android:textColor="#999999"
            android:textSize="18sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_themFile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btndetail"
            android:fontFamily="@font/nunito_black"
            android:paddingHorizontal="15dp"
            android:stateListAnimator="@animator/btn_nhung"
            android:text="Xác nhận thêm"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>


</LinearLayout>