<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#6B5EFD"
    android:padding="10dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/imgAvatar"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:src="@drawable/avatar"
        android:stateListAnimator="@animator/btn_nhung"
        app:civ_border_color="@color/white"
        app:civ_border_width="2dp"


        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtHo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="25dp"
        android:clickable="true"
        android:fontFamily="@font/nunito_medium"
        android:letterSpacing="0.1"
        android:stateListAnimator="@animator/btn_nhung"
        android:text="Người mới"
        android:textColor="@color/white"
        android:textFontWeight="400"
        android:textSize="14sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imgAvatar"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtHoten"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:clickable="true"
        android:fontFamily="@font/nunito_black"
        android:letterSpacing="0.1"
        android:stateListAnimator="@animator/btn_nhung"
        android:text="Guest"
        android:textColor="@color/white"
        android:textSize="24sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imgAvatar"
        app:layout_constraintTop_toBottomOf="@+id/txtHo" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDetail"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btndetail"
        android:fontFamily="@font/nunito_medium"
        android:stateListAnimator="@animator/btngames"
        android:text="Chi tiết"
        android:textAllCaps="false"
        android:textColor="#DDDDDD"
        android:textSize="14sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtHoten" />

    <TextView
        android:id="@+id/txtStreak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:clickable="true"
        android:fontFamily="@font/nunito_black"
        android:letterSpacing="0.1"
        android:stateListAnimator="@animator/btn_nhung"
        android:text="9999"
        android:textColor="#A7B1FA"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/ic_streak"
        app:layout_constraintTop_toBottomOf="@+id/txtHoten" />

    <ImageView
        android:id="@+id/ic_streak"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="10dp"
        android:paddingTop="2dp"
        android:clickable="true"
        android:stateListAnimator="@animator/btn_nhung"
        android:src="@drawable/ic_fish"
        android:tint="#A7B1FA"
        app:layout_constraintStart_toEndOf="@+id/imgAvatar"
        app:layout_constraintTop_toBottomOf="@+id/txtHoten" />


</androidx.constraintlayout.widget.ConstraintLayout>