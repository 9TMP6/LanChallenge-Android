<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="7dp"
    android:background="@drawable/bg_item_word"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/btn_nhung">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:id="@+id/lKey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txt_word_key"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_black"
                android:gravity="start"
                android:maxLength="60"
                android:maxLines="3"
                android:text="Democratic"
                android:textColor="#333333"
                android:textFontWeight="1000"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txt_word_ipa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/nunito_black"
                android:gravity="end"
                android:paddingBottom="3dp"
                android:letterSpacing="0.1"
                android:text="/hello/"
                android:textColor="#19B189"
                android:textSize="14sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txt_word_mean"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/nunito_black"
            android:maxLines="3"
            android:text="Dân chủ, sự dân chủ"
            android:textColor="#6C757D"
            android:textSize="14sp"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lKey" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>