<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <objectAnimator
            android:propertyName="translationX"
            android:valueTo="-5dp"
            android:duration="50"
            android:valueType="floatType"
            />
    </item>
    <item>
        <objectAnimator
            android:propertyName="translationX"
            android:valueTo="0dp"
            android:duration="50"
            android:valueType="floatType"
            />
    </item>
</selector>